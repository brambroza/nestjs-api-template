# Copy to .env for local development. The zod schema in
# src/shared/config/env.schema.ts crashes boot if anything required
# below is missing.

APP_ENV=development
APP_NAME=nestjs-api-template
PORT=3000
LOG_LEVEL=debug
REQUEST_TIMEOUT_MS=15000
SHUTDOWN_GRACE_MS=20000

# Local docker-compose (see docker-compose.yml).
DATABASE_URL="sqlserver://localhost:1433;database=nestjs_api_template;user=sa;password=LocalDev@P4ssw0rd!;trustServerCertificate=true;encrypt=true"
REDIS_URL=redis://localhost:6379/0

# 32+ chars minimum. Rotate per environment.
JWT_SECRET=change-me-to-a-real-secret-that-is-at-least-32-characters-long
JWT_ISSUER=nestjs-api-template
JWT_AUDIENCE=nestjs-api-template

# LINE Messaging API credentials. Ask the LINE Developers console.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-real-line-channel-access-token
LINE_CHANNEL_SECRET=replace-with-real-line-channel-secret
LINE_API_BASE_URL=https://api.line.me

# Per-tenant defaults (satang for money, basis points for tolerance).
# Values in the Tenant DB row override these on a per-tenant basis.
DEFAULT_DUAL_APPROVAL_THRESHOLD_SATANG=50000000
DEFAULT_OVER_TOLERANCE_BASIS_POINTS=500
DEFAULT_UNDER_TOLERANCE_BASIS_POINTS=0

# Outbox worker (ADR 0003).
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=7
