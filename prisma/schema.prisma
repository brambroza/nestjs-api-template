// Prisma schema — Microsoft SQL Server (per ADR 0001).
//
// Conventions:
//   * PK is a NVARCHAR(36) — we generate UUIDs in the application layer.
//   * tenantId is always present and always the leading column of
//     multi-column indexes for query-planner locality (R10).
//   * We do NOT use SQL Server `rowversion` for optimistic locking
//     (see ADR 0001 §4.1). We use an explicit `version INT`.
//   * JSON is stored as NVARCHAR(MAX) (SQL Server has no native JSON
//     type). Parse at the application boundary.
//   * Quantities and money are stored as BigInt — the domain layer's
//     Money/Quantity are bigint end-to-end (R5, no float).
//   * All tenant FKs are `onDelete: NoAction, onUpdate: NoAction`
//     because MSSQL rejects multiple cascading paths and we already
//     have one (via ProductionOrder). Cleanup is orchestrated at the
//     application layer.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenants
// ---------------------------------------------------------------------------

model Tenant {
  id                             String   @id @db.NVarChar(36)
  name                           String   @db.NVarChar(200)
  dualApprovalThresholdSatang    BigInt
  overToleranceBasisPoints       BigInt
  underToleranceBasisPoints      BigInt
  /// FIFO | WEIGHTED_AVG — inventory costing engine (EPIC-C.1).
  costingMethod                  String   @default("FIFO") @db.NVarChar(16)
  createdAt                      DateTime @default(now()) @db.DateTime2
  updatedAt                      DateTime @updatedAt @db.DateTime2

  productionOrders               ProductionOrder[]
  outboxMessages                 OutboxMessage[]
  bomLines                       BomLine[]
  calendars                      TenantCalendar[]
  progressReports                ProgressReport[]
  stock                          StockLevel[]
  users                          User[]
  roles                          Role[]
  customers                      Customer[]
  vendors                        Vendor[]
  items                          Item[]
  uomDefinitions                 UomDefinition[]
  companies                      Company[]
  branches                       Branch[]
  warehouses                     Warehouse[]
  partnerContacts                PartnerContact[]
  partnerAddresses               PartnerAddress[]
  pdpaConsents                   PdpaConsent[]
  pdpaRequests                   PdpaRequest[]
  itemCategories                 ItemCategory[]
  priceLists                     PriceList[]
  priceListLines                 PriceListLine[]
  boms                           Bom[]
  bomComponents                  BomComponent[]
  currencies                     Currency[]
  fxRates                        FxRate[]
  taxCodes                       TaxCode[]
  itemTaxOverrides               ItemTaxOverride[]
  accounts                       Account[]
  fiscalYears                    FiscalYear[]
  fiscalPeriods                  FiscalPeriod[]
  approvalPolicies               ApprovalPolicy[]
  approvalRequests               ApprovalRequest[]
  approvalDelegations            ApprovalDelegation[]
  documentSequences              DocumentSequence[]
  quotations                     Quotation[]
  quotationLines                 QuotationLine[]
  salesOrders                    SalesOrder[]
  salesOrderLines                SalesOrderLine[]
  deliveryNotes                  DeliveryNote[]
  deliveryNoteLines              DeliveryNoteLine[]
  purchaseRequisitions           PurchaseRequisition[]
  purchaseRequisitionLines       PurchaseRequisitionLine[]
  purchaseOrders                 PurchaseOrder[]
  purchaseOrderLines             PurchaseOrderLine[]
  goodsReceipts                  GoodsReceipt[]
  goodsReceiptLines              GoodsReceiptLine[]
  lots                           Lot[]
  serialUnits                    SerialUnit[]
  stockBalances                  StockBalance[]
  stockMovements                 StockMovement[]
  costLayers                     CostLayer[]
  averageCosts                   AverageCost[]
  reservations                   StockReservation[]
  stockTransfers                 StockTransfer[]
  stockTransferLines             StockTransferLine[]

  @@map("tenant")
}

// ---------------------------------------------------------------------------
// Document numbering — shared by every transactional document (Phase B).
// ---------------------------------------------------------------------------

/// One counter per (tenant, key). Key = "<prefix>:<yyyymm>" so numbers
/// restart monthly (QT-202609-0001). Incremented inside the document's
/// own transaction; the row lock serialises concurrent creators.
model DocumentSequence {
  tenantId  String   @db.NVarChar(36)
  key       String   @db.NVarChar(32)
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, key])
  @@map("doc_sequence")
}

// ---------------------------------------------------------------------------
// Sales — Quotation (EPIC-B.1)
// ---------------------------------------------------------------------------

/// Revisions share `number`; (number, revision) is unique. Money in minor
/// units of `currency`. `version` is the optimistic-lock counter
/// (ADR 0002 §6).
model Quotation {
  id               String    @id @db.NVarChar(36)
  tenantId         String    @db.NVarChar(36)
  companyId        String    @db.NVarChar(36)
  number           String    @db.NVarChar(24)
  revision         Int       @default(1)
  customerId       String    @db.NVarChar(36)
  currency         String    @db.NVarChar(3)
  quoteDate        DateTime  @db.Date
  validUntil       DateTime  @db.Date
  /// DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CANCELLED
  status           String    @db.NVarChar(12)
  paymentTermsDays Int
  notes            String?   @db.NVarChar(Max)
  subtotalMinor    BigInt
  discountMinor    BigInt
  taxMinor         BigInt
  totalMinor       BigInt
  version          Int       @default(0)
  createdBy        String    @db.NVarChar(64)
  sentAt           DateTime? @db.DateTime2
  resolvedAt       DateTime? @db.DateTime2
  rejectReason     String?   @db.NVarChar(500)
  /// Set by the sales-order module when an ACCEPTED quotation is converted.
  salesOrderId     String?   @db.NVarChar(36)
  createdAt        DateTime  @db.DateTime2
  updatedAt        DateTime  @updatedAt @db.DateTime2

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines  QuotationLine[]

  @@unique([tenantId, number, revision])
  @@index([tenantId, customerId, status])
  @@index([tenantId, status, validUntil])
  @@map("sls_quotation")
}

model QuotationLine {
  id             String  @id @db.NVarChar(36)
  tenantId       String  @db.NVarChar(36)
  quotationId    String  @db.NVarChar(36)
  lineNo         Int
  itemId         String  @db.NVarChar(36)
  itemSku        String  @db.NVarChar(64)
  description    String  @db.NVarChar(200)
  uomCode        String  @db.NVarChar(16)
  quantity       BigInt
  unitPriceMinor BigInt
  /// PRICE_LIST | MANUAL
  priceSource    String  @db.NVarChar(12)
  priceListId    String? @db.NVarChar(36)
  discountBp     Int     @default(0)
  discountMinor  BigInt
  netMinor       BigInt
  taxCodeId      String  @db.NVarChar(36)
  taxCode        String  @db.NVarChar(16)
  taxRateBp      Int
  taxMinor       BigInt
  totalMinor     BigInt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([quotationId, lineNo])
  @@index([tenantId, itemId])
  @@map("sls_quotation_line")
}

// ---------------------------------------------------------------------------
// Approval framework (EPIC-B.4) — shared by every document type.
// ---------------------------------------------------------------------------

/// One active policy per (tenant, documentType). Steps run in order;
/// a step with minAmountMinor applies only when the document amount
/// reaches it (the "approval matrix" — tiers by amount).
model ApprovalPolicy {
  id           String   @id @db.NVarChar(36)
  tenantId     String   @db.NVarChar(36)
  /// e.g. SALES_ORDER, PURCHASE_REQUISITION, PURCHASE_ORDER, QUOTATION
  documentType String   @db.NVarChar(32)
  name         String   @db.NVarChar(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.DateTime2
  updatedAt    DateTime @updatedAt @db.DateTime2

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  steps  ApprovalPolicyStep[]

  @@index([tenantId, documentType, isActive])
  @@map("apv_policy")
}

model ApprovalPolicyStep {
  id                String  @id @db.NVarChar(36)
  tenantId          String  @db.NVarChar(36)
  policyId          String  @db.NVarChar(36)
  stepNo            Int
  name              String  @db.NVarChar(100)
  /// Role NAME (app_role.name) whose members may decide this step.
  approverRole      String  @db.NVarChar(64)
  /// Step applies only when amount >= this; NULL = always.
  minAmountMinor    BigInt?
  requiredApprovals Int     @default(1)

  policy ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([policyId, stepNo])
  @@map("apv_policy_step")
}

/// A document's request for approval. At most one PENDING per document.
model ApprovalRequest {
  id            String    @id @db.NVarChar(36)
  tenantId      String    @db.NVarChar(36)
  documentType  String    @db.NVarChar(32)
  documentId    String    @db.NVarChar(36)
  policyId      String?   @db.NVarChar(36)
  amountMinor   BigInt
  currency      String    @db.NVarChar(3)
  requestedBy   String    @db.NVarChar(64)
  /// PENDING | APPROVED | REJECTED | CANCELLED
  status        String    @db.NVarChar(12)
  currentStepNo Int?
  createdAt     DateTime  @db.DateTime2
  resolvedAt    DateTime? @db.DateTime2
  updatedAt     DateTime  @updatedAt @db.DateTime2

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  steps  ApprovalRequestStep[]

  @@index([tenantId, documentType, documentId])
  @@index([tenantId, status])
  @@map("apv_request")
}

model ApprovalRequestStep {
  id                String @id @db.NVarChar(36)
  tenantId          String @db.NVarChar(36)
  requestId         String @db.NVarChar(36)
  stepNo            Int
  name              String @db.NVarChar(100)
  approverRole      String @db.NVarChar(64)
  requiredApprovals Int
  /// PENDING | APPROVED | REJECTED
  status            String @db.NVarChar(12)

  request   ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decisions ApprovalDecision[]

  @@unique([requestId, stepNo])
  @@index([tenantId, approverRole, status])
  @@map("apv_request_step")
}

model ApprovalDecision {
  id         String   @id @db.NVarChar(36)
  tenantId   String   @db.NVarChar(36)
  stepId     String   @db.NVarChar(36)
  decidedBy  String   @db.NVarChar(64)
  /// Set when the decider acted under a delegation from this user.
  onBehalfOf String?  @db.NVarChar(64)
  /// APPROVE | REJECT
  decision   String   @db.NVarChar(8)
  comment    String?  @db.NVarChar(500)
  decidedAt  DateTime @db.DateTime2

  step ApprovalRequestStep @relation(fields: [stepId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, decidedBy])
  @@map("apv_decision")
}

/// "While I am away, B may decide in my place" (T-232). Date-bounded,
/// revocable; B inherits A's roles for approval eligibility only.
model ApprovalDelegation {
  id         String   @id @db.NVarChar(36)
  tenantId   String   @db.NVarChar(36)
  fromUserId String   @db.NVarChar(64)
  toUserId   String   @db.NVarChar(64)
  fromDate   DateTime @db.Date
  toDate     DateTime @db.Date
  reason     String?  @db.NVarChar(200)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, toUserId, isActive])
  @@index([tenantId, fromUserId])
  @@map("apv_delegation")
}

// ---------------------------------------------------------------------------
// Financial configuration (EPIC-A.4)
// ---------------------------------------------------------------------------

model Currency {
  id         String   @id @db.NVarChar(36)
  tenantId   String   @db.NVarChar(36)
  /// ISO 4217 alpha code.
  code       String   @db.NVarChar(3)
  name       String   @db.NVarChar(64)
  /// Decimal places of the minor unit: THB 2, JPY 0, KWD 3.
  minorUnits Int      @default(2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.DateTime2
  updatedAt  DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@map("md_currency")
}

/// "1 unit of quoteCurrency = rateScaled / 1e6 units of baseCurrency".
/// BOT publishes THB per unit of foreign currency, so base=THB, quote=USD,
/// rateScaled=33123400 means 1 USD = 33.1234 THB. bigint, never float (R5).
model FxRate {
  id            String   @id @db.NVarChar(36)
  tenantId      String   @db.NVarChar(36)
  baseCurrency  String   @db.NVarChar(3)
  quoteCurrency String   @db.NVarChar(3)
  rateDate      DateTime @db.Date
  rateScaled    BigInt
  /// BOT | MANUAL
  source        String   @db.NVarChar(16)
  fetchedAt     DateTime @db.DateTime2
  createdBy     String?  @db.NVarChar(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, baseCurrency, quoteCurrency, rateDate])
  @@index([tenantId, quoteCurrency, rateDate])
  @@map("fin_fx_rate")
}

/// VAT: vatTreatment STANDARD (7%) | ZERO_RATED (0%, export) | EXEMPT
/// (ยกเว้น, no VAT and no input credit). WHT: rate + the PND form the
/// certificate is filed under (PND3 individuals, PND53 juristic).
model TaxCode {
  id              String   @id @db.NVarChar(36)
  tenantId        String   @db.NVarChar(36)
  code            String   @db.NVarChar(16)
  name            String   @db.NVarChar(100)
  /// VAT | WHT
  kind            String   @db.NVarChar(8)
  rateBasisPoints BigInt
  vatTreatment    String?  @db.NVarChar(12)
  pndForm         String?  @db.NVarChar(8)
  whtIncomeType   String?  @db.NVarChar(100)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.DateTime2
  updatedAt       DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@index([tenantId, kind, isActive])
  @@map("fin_tax_code")
}

/// "This item uses tax code X for kind K instead of the tenant default"
/// — how exempt / zero-rated items are expressed.
model ItemTaxOverride {
  id        String   @id @db.NVarChar(36)
  tenantId  String   @db.NVarChar(36)
  itemId    String   @db.NVarChar(36)
  kind      String   @db.NVarChar(8)
  taxCodeId String   @db.NVarChar(36)
  reason    String?  @db.NVarChar(200)
  createdAt DateTime @default(now()) @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, itemId, kind])
  @@map("fin_item_tax_override")
}

/// Chart of accounts (ผังบัญชี). Tree like item categories; type is
/// inherited down the tree; only postable leaves receive journal lines.
model Account {
  id         String   @id @db.NVarChar(36)
  tenantId   String   @db.NVarChar(36)
  code       String   @db.NVarChar(16)
  name       String   @db.NVarChar(200)
  nameTh     String?  @db.NVarChar(200)
  /// ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  type       String   @db.NVarChar(12)
  parentId   String?  @db.NVarChar(36)
  path       String   @db.NVarChar(2000)
  depth      Int
  isPostable Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.DateTime2
  updatedAt  DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([tenantId, type])
  @@map("fin_account")
}

/// Per legal entity. 12 monthly periods generated on create.
model FiscalYear {
  id        String    @id @db.NVarChar(36)
  tenantId  String    @db.NVarChar(36)
  companyId String    @db.NVarChar(36)
  name      String    @db.NVarChar(32)
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  /// OPEN | CLOSED
  status    String    @db.NVarChar(8)
  closedAt  DateTime? @db.DateTime2
  closedBy  String?   @db.NVarChar(64)
  createdAt DateTime  @default(now()) @db.DateTime2
  updatedAt DateTime  @updatedAt @db.DateTime2

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  periods FiscalPeriod[]

  @@unique([tenantId, companyId, name])
  @@index([tenantId, companyId, startDate])
  @@map("fin_fiscal_year")
}

model FiscalPeriod {
  id           String    @id @db.NVarChar(36)
  tenantId     String    @db.NVarChar(36)
  fiscalYearId String    @db.NVarChar(36)
  periodNo     Int
  startDate    DateTime  @db.Date
  endDate      DateTime  @db.Date
  /// OPEN | LOCKED | CLOSED
  status       String    @db.NVarChar(8)
  lockedAt     DateTime? @db.DateTime2
  lockedBy     String?   @db.NVarChar(64)
  lockReason   String?   @db.NVarChar(200)
  updatedAt    DateTime  @updatedAt @db.DateTime2

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fiscalYearId, periodNo])
  @@index([tenantId, startDate])
  @@map("fin_fiscal_period")
}

// ---------------------------------------------------------------------------
// Partner sub-resources — shared by Customer and Vendor.
//
// (partnerType, partnerId) is a polymorphic reference: partnerType is
// "CUSTOMER" or "VENDOR" and partnerId points at md_customer.id or
// md_vendor.id. MSSQL cannot express a polymorphic FK, so existence is
// enforced at the application layer via PartnerLookup (same pattern as
// branch -> company). Every query is prefixed by tenantId (R10).
// ---------------------------------------------------------------------------

model PartnerContact {
  id           String    @id @db.NVarChar(36)
  tenantId     String    @db.NVarChar(36)
  partnerType  String    @db.NVarChar(16)
  partnerId    String    @db.NVarChar(36)
  fullName     String    @db.NVarChar(200)
  position     String?   @db.NVarChar(100)
  email        String?   @db.NVarChar(200)
  phone        String?   @db.NVarChar(30)
  isPrimary    Boolean   @default(false)
  isActive     Boolean   @default(true)
  /// Set by a fulfilled PDPA erasure request. Personal fields are
  /// overwritten at the same time; the row is kept so document history
  /// that references contactId still resolves.
  erasedAt     DateTime? @db.DateTime2
  createdAt    DateTime  @default(now()) @db.DateTime2
  updatedAt    DateTime  @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, partnerType, partnerId])
  @@map("md_partner_contact")
}

model PartnerAddress {
  id           String   @id @db.NVarChar(36)
  tenantId     String   @db.NVarChar(36)
  partnerType  String   @db.NVarChar(16)
  partnerId    String   @db.NVarChar(36)
  /// BILLING | SHIPPING
  addressType  String   @db.NVarChar(16)
  label        String?  @db.NVarChar(100)
  line1        String   @db.NVarChar(200)
  line2        String?  @db.NVarChar(200)
  subDistrict  String?  @db.NVarChar(100)
  district     String?  @db.NVarChar(100)
  province     String?  @db.NVarChar(100)
  postalCode   String?  @db.NVarChar(10)
  countryCode  String   @default("TH") @db.NVarChar(2)
  /// For BILLING addresses of a Thai juristic partner: the partner's
  /// Revenue Department branch number that must print on the tax
  /// invoice ("สาขาที่ NNNNN", 00000 = head office).
  branchNumber String?  @db.NVarChar(5)
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.DateTime2
  updatedAt    DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, partnerType, partnerId])
  @@map("md_partner_address")
}

/// Append-only consent log (PDPA §19). Current state per purpose is the
/// latest row; never update or delete rows — the history is the
/// evidence the regulator asks for.
model PdpaConsent {
  id           String   @id @db.NVarChar(36)
  tenantId     String   @db.NVarChar(36)
  partnerType  String   @db.NVarChar(16)
  partnerId    String   @db.NVarChar(36)
  /// Optional: the specific contact person who consented.
  contactId    String?  @db.NVarChar(36)
  /// MARKETING | ANALYTICS | THIRD_PARTY_SHARING
  purpose      String   @db.NVarChar(32)
  /// GRANT | WITHDRAW
  action       String   @db.NVarChar(16)
  /// WEB_FORM | PAPER_FORM | VERBAL | EMAIL | API
  source       String   @db.NVarChar(16)
  evidenceRef  String?  @db.NVarChar(200)
  note         String?  @db.NVarChar(500)
  recordedBy   String   @db.NVarChar(64)
  recordedAt   DateTime @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, partnerType, partnerId, recordedAt])
  @@map("pdpa_consent")
}

/// Data-subject request (PDPA §30 access/portability, §33 erasure).
model PdpaRequest {
  id           String    @id @db.NVarChar(36)
  tenantId     String    @db.NVarChar(36)
  partnerType  String    @db.NVarChar(16)
  partnerId    String    @db.NVarChar(36)
  /// EXPORT | ERASURE
  requestType  String    @db.NVarChar(16)
  /// PENDING | COMPLETED | REJECTED
  status       String    @db.NVarChar(16)
  reason       String?   @db.NVarChar(500)
  requestedBy  String    @db.NVarChar(64)
  requestedAt  DateTime  @db.DateTime2
  completedBy  String?   @db.NVarChar(64)
  completedAt  DateTime? @db.DateTime2
  resultNote   String?   @db.NVarChar(500)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, partnerType, partnerId, status])
  @@map("pdpa_request")
}

// ---------------------------------------------------------------------------
// Organisation structure — Tenant > Company > Branch > Warehouse
//
// A tenant may operate several legal entities (group of companies). Each
// legal entity has a Thai tax id and a registered name that appears on
// tax invoices. Branches map to the Revenue Department's "สาขาที่ NNNNN"
// numbering (00000 = head office). Warehouses are physical stock
// locations under a branch — inventory (Phase C) references warehouseId.
// ---------------------------------------------------------------------------

model Company {
  id             String   @id @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  code           String   @db.NVarChar(32)
  name           String   @db.NVarChar(200)
  /// Registered legal name as printed on tax invoices (may differ from `name`).
  legalName      String   @db.NVarChar(200)
  /// 13-digit Thai tax id (เลขประจำตัวผู้เสียภาษี). Optional for non-VAT entities.
  taxId          String?  @db.NVarChar(20)
  /// ISO 4217. Default reporting currency for this legal entity.
  baseCurrency   String   @default("THB") @db.NVarChar(3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branches   Branch[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("md_company")
}

model Branch {
  id             String   @id @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  companyId      String   @db.NVarChar(36)
  code           String   @db.NVarChar(32)
  name           String   @db.NVarChar(200)
  /// Revenue Department branch number, 5 digits; "00000" = head office.
  branchNumber   String   @default("00000") @db.NVarChar(5)
  addressLine1   String?  @db.NVarChar(200)
  addressLine2   String?  @db.NVarChar(200)
  subDistrict    String?  @db.NVarChar(100)
  district       String?  @db.NVarChar(100)
  province       String?  @db.NVarChar(100)
  postalCode     String?  @db.NVarChar(10)
  isHeadOffice   Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouses  Warehouse[]

  @@unique([tenantId, code])
  @@unique([tenantId, companyId, branchNumber])
  @@index([tenantId, companyId])
  @@map("md_branch")
}

model Warehouse {
  id             String   @id @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  branchId       String   @db.NVarChar(36)
  code           String   @db.NVarChar(32)
  name           String   @db.NVarChar(200)
  /// One default warehouse per branch — the fallback receiving location.
  isDefault      Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("md_warehouse")
}

// ---------------------------------------------------------------------------
// Users, roles, permissions
// ---------------------------------------------------------------------------

model User {
  id             String   @id @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  email          String   @db.NVarChar(200)
  passwordHash   String   @db.NVarChar(200)
  displayName    String   @db.NVarChar(200)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId, email])
  @@map("app_user")
}

/// Role stores its CASL rules as JSON so admins can edit them without
/// a redeploy. Shape: `[ { action: "approve", subject: "ProductionOrderApprove" } ]`.
/// `isSystem = true` marks built-in roles (admin/creator/approver/...)
/// that the seed sets up; the UI should hide the delete button on those.
model Role {
  id             String   @id @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  name           String   @db.NVarChar(64)
  permissionsJson String  @db.NVarChar(Max)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userRoles UserRole[]

  @@unique([tenantId, name])
  @@map("app_role")
}

model UserRole {
  userId    String   @db.NVarChar(36)
  roleId    String   @db.NVarChar(36)
  assignedAt DateTime @default(now()) @db.DateTime2

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("app_user_role")
}

// ---------------------------------------------------------------------------
// Partner master
// ---------------------------------------------------------------------------

model Customer {
  id                 String   @id @db.NVarChar(36)
  tenantId           String   @db.NVarChar(36)
  code               String   @db.NVarChar(32)
  name               String   @db.NVarChar(200)
  taxId              String?  @db.NVarChar(20)
  creditLimitSatang  BigInt   @default(0)
  paymentTermsDays   Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("md_customer")
}

model Vendor {
  id                 String   @id @db.NVarChar(36)
  tenantId           String   @db.NVarChar(36)
  code               String   @db.NVarChar(32)
  name               String   @db.NVarChar(200)
  taxId              String?  @db.NVarChar(20)
  paymentTermsDays   Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("md_vendor")
}

// ---------------------------------------------------------------------------
// Item master
// ---------------------------------------------------------------------------

model Item {
  id             String   @id @db.NVarChar(36)
  tenantId       String   @db.NVarChar(36)
  sku            String   @db.NVarChar(64)
  name           String   @db.NVarChar(200)
  description    String?  @db.NVarChar(Max)
  defaultUomCode String   @db.NVarChar(16)
  /// FK-less reference to md_item_category.id (validated at the
  /// application layer via CATEGORY_LOOKUP, same pattern as branch->company).
  categoryId     String?  @db.NVarChar(36)
  /// NONE | LOT | SERIAL — how inventory identifies units of this item.
  trackingPolicy String   @default("NONE") @db.NVarChar(8)
  /// Only meaningful when trackingPolicy = LOT.
  shelfLifeDays  Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])
  @@map("md_item")
}

/// UoM per tenant. `baseUomCode` + `conversionRatio` express
/// "1 <this uom> = <ratio> <baseUomCode>" so a box of 12 pcs is stored
/// as (code=BOX, baseUomCode=PCS, conversionRatio=12).
/// baseUomCode NULL means this row IS a base unit.
model UomDefinition {
  id              String  @id @db.NVarChar(36)
  tenantId        String  @db.NVarChar(36)
  code            String  @db.NVarChar(16)
  name            String  @db.NVarChar(64)
  baseUomCode     String? @db.NVarChar(16)
  /// Numerator × 10^-6 for fractional ratios. Stored as bigint so
  /// integer math survives (e.g. 1 kg = 1_000_000 g × 10^-6).
  conversionRatio BigInt  @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@map("md_uom")
}

model TenantCalendar {
  id           String   @id @db.NVarChar(36)
  tenantId     String   @db.NVarChar(36)
  date         DateTime @db.Date
  isWorkingDay Boolean
  note         String?  @db.NVarChar(200)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, date])
  @@index([tenantId, date])
  @@map("tenant_calendar")
}

// ---------------------------------------------------------------------------
// Production order aggregate
// ---------------------------------------------------------------------------

model ProductionOrder {
  id                       String   @id @db.NVarChar(36)
  tenantId                 String   @db.NVarChar(36)
  createdBy                String   @db.NVarChar(64)
  status                   String   @db.NVarChar(24)

  orderedQuantityValue     BigInt
  orderedQuantityUom       String   @db.NVarChar(16)

  /// The finished good being made. Nullable for orders created before
  /// master BOM existed; when set, BOM_LOOKUP resolves the active
  /// master-data BOM for this SKU unless the order carries its own
  /// frozen bom_line snapshot.
  productSku               String?  @db.NVarChar(64)

  totalAmountSatang        BigInt
  totalAmountCurrency      String   @db.NVarChar(3)

  firstApprover            String?  @db.NVarChar(64)
  secondApprover           String?  @db.NVarChar(64)

  producedQuantityValue    BigInt
  producedQuantityUom      String   @db.NVarChar(16)

  version                  Int      @default(0)

  createdAt                DateTime @db.DateTime2
  updatedAt                DateTime @db.DateTime2

  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progressReports          ProgressReport[]
  bomLines                 BomLine[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("production_order")
}

model ProgressReport {
  id                String   @id @db.NVarChar(36)
  productionOrderId String   @db.NVarChar(36)
  tenantId          String   @db.NVarChar(36)
  quantityValue     BigInt
  quantityUom       String   @db.NVarChar(16)
  reportedBy        String   @db.NVarChar(64)
  reportedAt        DateTime @db.DateTime2

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, productionOrderId])
  @@index([tenantId, reportedAt])
  @@map("progress_report")
}

// ---------------------------------------------------------------------------
// Bill of materials — one row per (order, component sku)
// ---------------------------------------------------------------------------

model BomLine {
  id                    String   @id @db.NVarChar(36)
  tenantId              String   @db.NVarChar(36)
  productionOrderId     String   @db.NVarChar(36)
  sku                   String   @db.NVarChar(64)
  requiredPerUnitValue  BigInt
  requiredPerUnitUom    String   @db.NVarChar(16)
  scrapBasisPoints      BigInt
  yieldBasisPoints      BigInt
  minPackValue          BigInt
  minPackUom            String   @db.NVarChar(16)

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, productionOrderId])
  @@map("bom_line")
}

// ---------------------------------------------------------------------------
// Stock — minimal per-tenant, per-SKU on-hand levels. Real installations
// hook InventoryPort to their ERP; the template ships with this table so
// R4 works end-to-end in a fresh clone.
// ---------------------------------------------------------------------------

model StockLevel {
  id           String   @id @db.NVarChar(36)
  tenantId     String   @db.NVarChar(36)
  sku          String   @db.NVarChar(64)
  onHandValue  BigInt
  onHandUom    String   @db.NVarChar(16)
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, sku])
  @@map("stock_level")
}

// ---------------------------------------------------------------------------
// Transactional outbox — also serves as R7 audit trail. Every domain event
// carries actor + fromStatus + toStatus + timestamp, so a single append-only
// table covers both delivery and audit. ADR 0003 governs the retention +
// worker semantics; a nightly job archives DELIVERED rows > 90 days old.
// ---------------------------------------------------------------------------

model OutboxMessage {
  id                String    @id @db.NVarChar(36)
  tenantId          String    @db.NVarChar(36)
  aggregateType     String    @db.NVarChar(64)
  aggregateId       String    @db.NVarChar(64)
  eventType         String    @db.NVarChar(128)
  payload           String    @db.NVarChar(Max)
  occurredAt        DateTime  @db.DateTime2
  status            String    @db.NVarChar(16)
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @db.DateTime2
  /// When the current IN_FLIGHT lease started. Cleared on DELIVERED /
  /// DEAD. A separate cron reclaims rows whose leasedAt is older than
  /// the stalled timeout (ADR 0003 §2.3).
  leasedAt          DateTime? @db.DateTime2
  lastError         String?   @db.NVarChar(1024)
  idempotencyKey    String    @unique @db.NVarChar(128)
  createdAt         DateTime  @default(now()) @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, nextAttemptAt])
  @@index([status, leasedAt])
  @@index([tenantId, aggregateId])
  @@index([tenantId, aggregateId, occurredAt])
  @@map("outbox_message")
}

// ---------------------------------------------------------------------------
// Item extras — categories, price lists, master BOM (EPIC-A.3)
// ---------------------------------------------------------------------------

/// Tree via parentId + materialized `path` ("/rootId/childId/.../selfId/")
/// so "everything under X" is one `startsWith` predicate. Depth is
/// capped at 50 by the domain (path column bound), which is "unlimited"
/// for any real catalogue.
model ItemCategory {
  id        String   @id @db.NVarChar(36)
  tenantId  String   @db.NVarChar(36)
  code      String   @db.NVarChar(32)
  name      String   @db.NVarChar(200)
  parentId  String?  @db.NVarChar(36)
  path      String   @db.NVarChar(2000)
  depth     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.DateTime2
  updatedAt DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@map("md_item_category")
}

/// customerId NULL = general list. Resolution prefers a customer-specific
/// list over a general one, then the highest minQty tier <= quantity.
model PriceList {
  id         String    @id @db.NVarChar(36)
  tenantId   String    @db.NVarChar(36)
  code       String    @db.NVarChar(32)
  name       String    @db.NVarChar(200)
  currency   String    @db.NVarChar(3)
  customerId String?   @db.NVarChar(36)
  validFrom  DateTime  @db.DateTime2
  validTo    DateTime? @db.DateTime2
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.DateTime2
  updatedAt  DateTime  @updatedAt @db.DateTime2

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines  PriceListLine[]

  @@unique([tenantId, code])
  @@index([tenantId, customerId, validFrom])
  @@map("md_price_list")
}

model PriceListLine {
  id              String   @id @db.NVarChar(36)
  tenantId        String   @db.NVarChar(36)
  priceListId     String   @db.NVarChar(36)
  itemId          String   @db.NVarChar(36)
  uomCode         String   @db.NVarChar(16)
  /// Quantity tier: this price applies from minQty upward.
  minQty          BigInt   @default(1)
  unitPriceSatang BigInt
  createdAt       DateTime @default(now()) @db.DateTime2

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([priceListId, itemId, uomCode, minQty])
  @@index([tenantId, itemId])
  @@map("md_price_list_line")
}

/// Master BOM per product item, versioned. At most one ACTIVE version per
/// item (filtered unique). Production orders resolve their component
/// requirements from the active version of the order's productSku.
model Bom {
  id         String   @id @db.NVarChar(36)
  tenantId   String   @db.NVarChar(36)
  itemId     String   @db.NVarChar(36)
  productSku String   @db.NVarChar(64)
  version    Int
  name       String?  @db.NVarChar(200)
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.DateTime2
  updatedAt  DateTime @updatedAt @db.DateTime2

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  components BomComponent[]

  @@unique([tenantId, itemId, version])
  @@index([tenantId, productSku, isActive])
  @@map("md_bom")
}

/// Same arithmetic shape as production-order's BomLine (R5): ratios in
/// basis points, quantities as bigint in the component's counted unit.
model BomComponent {
  id               String @id @db.NVarChar(36)
  tenantId         String @db.NVarChar(36)
  bomId            String @db.NVarChar(36)
  lineNo           Int
  componentItemId  String @db.NVarChar(36)
  componentSku     String @db.NVarChar(64)
  qtyPerUnitValue  BigInt
  qtyPerUnitUom    String @db.NVarChar(16)
  scrapBasisPoints BigInt @default(0)
  yieldBasisPoints BigInt @default(10000)
  minPackValue     BigInt @default(1)
  minPackUom       String @db.NVarChar(16)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bom    Bom    @relation(fields: [bomId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([bomId, lineNo])
  @@unique([bomId, componentItemId])
  @@index([tenantId, componentItemId])
  @@map("md_bom_component")
}

// ---------------------------------------------------------------------------
// Sales — Sales Order + Delivery Note (EPIC-B.2)
// ---------------------------------------------------------------------------

/// Status: DRAFT | PENDING_APPROVAL | CONFIRMED | PARTIALLY_DELIVERED |
/// DELIVERED | REJECTED | CANCELLED. creditStatus: NOT_CHECKED | NO_LIMIT |
/// OK | EXCEEDED (evaluated at submit; exposure = open orders + this one).
model SalesOrder {
  id                    String    @id @db.NVarChar(36)
  tenantId              String    @db.NVarChar(36)
  companyId             String    @db.NVarChar(36)
  number                String    @db.NVarChar(24)
  quotationId           String?   @db.NVarChar(36)
  customerId            String    @db.NVarChar(36)
  currency              String    @db.NVarChar(3)
  orderDate             DateTime  @db.Date
  requestedDeliveryDate DateTime? @db.Date
  status                String    @db.NVarChar(20)
  paymentTermsDays      Int
  notes                 String?   @db.NVarChar(Max)
  subtotalMinor         BigInt
  discountMinor         BigInt
  taxMinor              BigInt
  totalMinor            BigInt
  creditStatus          String    @default("NOT_CHECKED") @db.NVarChar(12)
  creditExposureMinor   BigInt    @default(0)
  approvalRequestId     String?   @db.NVarChar(36)
  version               Int       @default(0)
  createdBy             String    @db.NVarChar(64)
  submittedAt           DateTime? @db.DateTime2
  confirmedAt           DateTime? @db.DateTime2
  resolvedAt            DateTime? @db.DateTime2
  cancelReason          String?   @db.NVarChar(500)
  createdAt             DateTime  @db.DateTime2
  updatedAt             DateTime  @updatedAt @db.DateTime2

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines         SalesOrderLine[]
  deliveryNotes DeliveryNote[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, status])
  @@index([tenantId, status])
  @@map("sls_order")
}

model SalesOrderLine {
  id             String  @id @db.NVarChar(36)
  tenantId       String  @db.NVarChar(36)
  salesOrderId   String  @db.NVarChar(36)
  lineNo         Int
  itemId         String  @db.NVarChar(36)
  itemSku        String  @db.NVarChar(64)
  description    String  @db.NVarChar(200)
  uomCode        String  @db.NVarChar(16)
  quantity       BigInt
  deliveredQty   BigInt  @default(0)
  unitPriceMinor BigInt
  priceSource    String  @db.NVarChar(12)
  priceListId    String? @db.NVarChar(36)
  discountBp     Int     @default(0)
  discountMinor  BigInt
  netMinor       BigInt
  taxCodeId      String  @db.NVarChar(36)
  taxCode        String  @db.NVarChar(16)
  taxRateBp      Int
  taxMinor       BigInt
  totalMinor     BigInt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([salesOrderId, lineNo])
  @@index([tenantId, itemId])
  @@map("sls_order_line")
}

/// Status: DRAFT | SHIPPED | CANCELLED. Shipping posts deliveredQty onto
/// the order lines in the same transaction. Stock movement is Phase C.
model DeliveryNote {
  id            String    @id @db.NVarChar(36)
  tenantId      String    @db.NVarChar(36)
  salesOrderId  String    @db.NVarChar(36)
  number        String    @db.NVarChar(24)
  status        String    @db.NVarChar(12)
  deliveryDate  DateTime  @db.Date
  warehouseId   String?   @db.NVarChar(36)
  shipToAddress String?   @db.NVarChar(500)
  notes         String?   @db.NVarChar(Max)
  version       Int       @default(0)
  createdBy     String    @db.NVarChar(64)
  shippedAt     DateTime? @db.DateTime2
  createdAt     DateTime  @db.DateTime2
  updatedAt     DateTime  @updatedAt @db.DateTime2

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salesOrder SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines      DeliveryNoteLine[]

  @@unique([tenantId, number])
  @@index([tenantId, salesOrderId])
  @@map("sls_delivery_note")
}

model DeliveryNoteLine {
  id               String @id @db.NVarChar(36)
  tenantId         String @db.NVarChar(36)
  deliveryNoteId   String @db.NVarChar(36)
  lineNo           Int
  salesOrderLineId String @db.NVarChar(36)
  itemId           String @db.NVarChar(36)
  itemSku          String @db.NVarChar(64)
  uomCode          String @db.NVarChar(16)
  quantity         BigInt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([deliveryNoteId, lineNo])
  @@index([tenantId, salesOrderLineId])
  @@map("sls_delivery_note_line")
}

// ---------------------------------------------------------------------------
// Purchase — Requisition, Purchase Order, Goods Receipt (EPIC-B.3)
// ---------------------------------------------------------------------------

/// Status: DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | CANCELLED | CONVERTED.
/// Estimated amounts only; the PO carries the real prices.
model PurchaseRequisition {
  id                  String    @id @db.NVarChar(36)
  tenantId            String    @db.NVarChar(36)
  companyId           String    @db.NVarChar(36)
  number              String    @db.NVarChar(24)
  requesterId         String    @db.NVarChar(64)
  neededByDate        DateTime? @db.Date
  purpose             String?   @db.NVarChar(500)
  status              String    @db.NVarChar(20)
  currency            String    @db.NVarChar(3)
  estimatedTotalMinor BigInt
  approvalRequestId   String?   @db.NVarChar(36)
  purchaseOrderId     String?   @db.NVarChar(36)
  version             Int       @default(0)
  createdBy           String    @db.NVarChar(64)
  submittedAt         DateTime? @db.DateTime2
  resolvedAt          DateTime? @db.DateTime2
  createdAt           DateTime  @db.DateTime2
  updatedAt           DateTime  @updatedAt @db.DateTime2

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines  PurchaseRequisitionLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, requesterId])
  @@map("pur_requisition")
}

model PurchaseRequisitionLine {
  id                      String  @id @db.NVarChar(36)
  tenantId                String  @db.NVarChar(36)
  requisitionId           String  @db.NVarChar(36)
  lineNo                  Int
  itemId                  String  @db.NVarChar(36)
  itemSku                 String  @db.NVarChar(64)
  description             String  @db.NVarChar(200)
  uomCode                 String  @db.NVarChar(16)
  quantity                BigInt
  estimatedUnitPriceMinor BigInt  @default(0)
  estimatedTotalMinor     BigInt  @default(0)
  suggestedVendorId       String? @db.NVarChar(36)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([requisitionId, lineNo])
  @@index([tenantId, itemId])
  @@map("pur_requisition_line")
}

/// Status: DRAFT | PENDING_APPROVAL | ISSUED | PARTIALLY_RECEIVED | RECEIVED |
/// REJECTED | CANCELLED. Money in minor units of `currency`.
model PurchaseOrder {
  id                String    @id @db.NVarChar(36)
  tenantId          String    @db.NVarChar(36)
  companyId         String    @db.NVarChar(36)
  number            String    @db.NVarChar(24)
  requisitionId     String?   @db.NVarChar(36)
  vendorId          String    @db.NVarChar(36)
  currency          String    @db.NVarChar(3)
  orderDate         DateTime  @db.Date
  expectedDate      DateTime? @db.Date
  status            String    @db.NVarChar(20)
  paymentTermsDays  Int
  notes             String?   @db.NVarChar(Max)
  subtotalMinor     BigInt
  discountMinor     BigInt
  taxMinor          BigInt
  totalMinor        BigInt
  approvalRequestId String?   @db.NVarChar(36)
  version           Int       @default(0)
  createdBy         String    @db.NVarChar(64)
  submittedAt       DateTime? @db.DateTime2
  issuedAt          DateTime? @db.DateTime2
  resolvedAt        DateTime? @db.DateTime2
  cancelReason      String?   @db.NVarChar(500)
  createdAt         DateTime  @db.DateTime2
  updatedAt         DateTime  @updatedAt @db.DateTime2

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, number])
  @@index([tenantId, vendorId, status])
  @@index([tenantId, status])
  @@map("pur_order")
}

model PurchaseOrderLine {
  id              String  @id @db.NVarChar(36)
  tenantId        String  @db.NVarChar(36)
  purchaseOrderId String  @db.NVarChar(36)
  lineNo          Int
  itemId          String  @db.NVarChar(36)
  itemSku         String  @db.NVarChar(64)
  description     String  @db.NVarChar(200)
  uomCode         String  @db.NVarChar(16)
  quantity        BigInt
  receivedQty     BigInt  @default(0)
  unitPriceMinor  BigInt
  priceSource     String  @db.NVarChar(12)
  priceListId     String? @db.NVarChar(36)
  discountBp      Int     @default(0)
  discountMinor   BigInt
  netMinor        BigInt
  taxCodeId       String  @db.NVarChar(36)
  taxCode         String  @db.NVarChar(16)
  taxRateBp       Int
  taxMinor        BigInt
  totalMinor      BigInt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([purchaseOrderId, lineNo])
  @@index([tenantId, itemId])
  @@map("pur_order_line")
}

/// Status: DRAFT | POSTED | CANCELLED. Posting captures receivedQty (and
/// lot / expiry for LOT-tracked items) on the PO lines. Stock is Phase C.
model GoodsReceipt {
  id                String    @id @db.NVarChar(36)
  tenantId          String    @db.NVarChar(36)
  purchaseOrderId   String    @db.NVarChar(36)
  number            String    @db.NVarChar(24)
  status            String    @db.NVarChar(12)
  receiptDate       DateTime  @db.Date
  warehouseId       String    @db.NVarChar(36)
  vendorDeliveryRef String?   @db.NVarChar(64)
  notes             String?   @db.NVarChar(Max)
  version           Int       @default(0)
  createdBy         String    @db.NVarChar(64)
  postedAt          DateTime? @db.DateTime2
  createdAt         DateTime  @db.DateTime2
  updatedAt         DateTime  @updatedAt @db.DateTime2

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines         GoodsReceiptLine[]

  @@unique([tenantId, number])
  @@index([tenantId, purchaseOrderId])
  @@map("pur_goods_receipt")
}

model GoodsReceiptLine {
  id                  String    @id @db.NVarChar(36)
  tenantId            String    @db.NVarChar(36)
  goodsReceiptId      String    @db.NVarChar(36)
  lineNo              Int
  purchaseOrderLineId String    @db.NVarChar(36)
  itemId              String    @db.NVarChar(36)
  itemSku             String    @db.NVarChar(64)
  uomCode             String    @db.NVarChar(16)
  quantity            BigInt
  lotNumber           String?   @db.NVarChar(64)
  expiryDate          DateTime? @db.Date

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([goodsReceiptId, lineNo])
  @@index([tenantId, purchaseOrderLineId])
  @@map("pur_goods_receipt_line")
}

// ---------------------------------------------------------------------------
// Inventory (EPIC-C.1) — append-only movement ledger + projected balances
// ---------------------------------------------------------------------------

model Lot {
  id         String    @id @db.NVarChar(36)
  tenantId   String    @db.NVarChar(36)
  itemId     String    @db.NVarChar(36)
  lotNumber  String    @db.NVarChar(64)
  expiryDate DateTime? @db.Date
  createdAt  DateTime  @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, itemId, lotNumber])
  @@index([tenantId, expiryDate])
  @@map("inv_lot")
}

/// One row per serialised unit. status: IN_STOCK | RESERVED | ISSUED.
model SerialUnit {
  id           String    @id @db.NVarChar(36)
  tenantId     String    @db.NVarChar(36)
  itemId       String    @db.NVarChar(36)
  serialNumber String    @db.NVarChar(64)
  warehouseId  String?   @db.NVarChar(36)
  lotId        String?   @db.NVarChar(36)
  status       String    @db.NVarChar(12)
  lastMovementId String? @db.NVarChar(36)
  createdAt    DateTime  @db.DateTime2
  updatedAt    DateTime  @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, itemId, serialNumber])
  @@index([tenantId, serialNumber])
  @@map("inv_serial")
}

/// Projection of the ledger per (warehouse, item, lot). available = onHand − reserved.
model StockBalance {
  id          String   @id @db.NVarChar(36)
  tenantId    String   @db.NVarChar(36)
  warehouseId String   @db.NVarChar(36)
  itemId      String   @db.NVarChar(36)
  lotId       String?  @db.NVarChar(36)
  uomCode     String   @db.NVarChar(16)
  onHandQty   BigInt   @default(0)
  reservedQty BigInt   @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, warehouseId, itemId, lotId])
  @@index([tenantId, itemId])
  @@map("inv_stock_balance")
}

/// Append-only. type: RECEIPT | ISSUE | TRANSFER_OUT | TRANSFER_IN | RESERVE |
/// UNRESERVE | ADJUST_IN | ADJUST_OUT. quantity is always positive; the
/// type carries the sign. costMinor = value moved (receipts: qty × unit
/// cost; issues: FIFO / average consumption), for the GL (EPIC-C.4).
model StockMovement {
  id            String   @id @db.NVarChar(36)
  tenantId      String   @db.NVarChar(36)
  warehouseId   String   @db.NVarChar(36)
  itemId        String   @db.NVarChar(36)
  itemSku       String   @db.NVarChar(64)
  lotId         String?  @db.NVarChar(36)
  uomCode       String   @db.NVarChar(16)
  type          String   @db.NVarChar(16)
  quantity      BigInt
  unitCostMinor BigInt   @default(0)
  costMinor     BigInt   @default(0)
  currency      String   @db.NVarChar(3)
  referenceType String   @db.NVarChar(32)
  referenceId   String   @db.NVarChar(36)
  reason        String?  @db.NVarChar(500)
  serialNumbers String?  @db.NVarChar(Max)
  occurredAt    DateTime @db.DateTime2
  createdBy     String   @db.NVarChar(64)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, itemId, occurredAt])
  @@index([tenantId, warehouseId, occurredAt])
  @@index([tenantId, referenceType, referenceId])
  @@map("inv_stock_movement")
}

/// FIFO layers: one per receipt, consumed oldest first.
model CostLayer {
  id            String   @id @db.NVarChar(36)
  tenantId      String   @db.NVarChar(36)
  warehouseId   String   @db.NVarChar(36)
  itemId        String   @db.NVarChar(36)
  lotId         String?  @db.NVarChar(36)
  movementId    String   @db.NVarChar(36)
  receivedAt    DateTime @db.DateTime2
  originalQty   BigInt
  remainingQty  BigInt
  unitCostMinor BigInt
  currency      String   @db.NVarChar(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, warehouseId, itemId, receivedAt])
  @@map("inv_cost_layer")
}

/// Weighted-average cost per (tenant, item); maintained on every receipt.
model AverageCost {
  id            String   @id @db.NVarChar(36)
  tenantId      String   @db.NVarChar(36)
  itemId        String   @db.NVarChar(36)
  quantity      BigInt   @default(0)
  totalCostMinor BigInt  @default(0)
  unitCostMinor BigInt   @default(0)
  currency      String   @db.NVarChar(3)
  version       Int      @default(0)
  updatedAt     DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, itemId])
  @@map("inv_average_cost")
}

/// Active holds per document. status: ACTIVE | RELEASED | CONSUMED.
model StockReservation {
  id            String   @id @db.NVarChar(36)
  tenantId      String   @db.NVarChar(36)
  warehouseId   String   @db.NVarChar(36)
  itemId        String   @db.NVarChar(36)
  lotId         String?  @db.NVarChar(36)
  uomCode       String   @db.NVarChar(16)
  quantity      BigInt
  status        String   @db.NVarChar(12)
  referenceType String   @db.NVarChar(32)
  referenceId   String   @db.NVarChar(36)
  createdAt     DateTime @db.DateTime2
  updatedAt     DateTime @updatedAt @db.DateTime2

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, referenceType, referenceId, status])
  @@index([tenantId, warehouseId, itemId, status])
  @@map("inv_reservation")
}

/// Warehouse-to-warehouse transfer. status: DRAFT | IN_TRANSIT | RECEIVED | CANCELLED.
model StockTransfer {
  id              String    @id @db.NVarChar(36)
  tenantId        String    @db.NVarChar(36)
  number          String    @db.NVarChar(24)
  fromWarehouseId String    @db.NVarChar(36)
  toWarehouseId   String    @db.NVarChar(36)
  status          String    @db.NVarChar(12)
  notes           String?   @db.NVarChar(Max)
  version         Int       @default(0)
  createdBy       String    @db.NVarChar(64)
  shippedAt       DateTime? @db.DateTime2
  receivedAt      DateTime? @db.DateTime2
  createdAt       DateTime  @db.DateTime2
  updatedAt       DateTime  @updatedAt @db.DateTime2

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines  StockTransferLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("inv_transfer")
}

model StockTransferLine {
  id            String  @id @db.NVarChar(36)
  tenantId      String  @db.NVarChar(36)
  transferId    String  @db.NVarChar(36)
  lineNo        Int
  itemId        String  @db.NVarChar(36)
  itemSku       String  @db.NVarChar(64)
  lotId         String? @db.NVarChar(36)
  uomCode       String  @db.NVarChar(16)
  quantity      BigInt
  /// Cost carried from the source warehouse at ship time (re-layered at destination).
  unitCostMinor BigInt  @default(0)
  serialNumbers String? @db.NVarChar(Max)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([transferId, lineNo])
  @@map("inv_transfer_line")
}
